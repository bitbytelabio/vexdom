s\" [ref=e2123]\n- link \"timeouts, sleeps, and intervals\" [ref=e2124]\n- link \"performing asynchronous I/O\" [ref=e2125]\n- link \"TCP and UDP\" [ref=e2126]\n- link \"filesystem\" [ref=e2127]\n- link \"process\" [ref=e2128] hint=\"in:APIs for performing asynchronous I/O, includi\"\n- link \"signal\" [ref=e2129] hint=\"in:APIs for performing asynchronous I/O, includi\"\n- link \"runtime\" [ref=e2130] hint=\"in:A for executing asynchronous code, including \"\n- link \"website\" [ref=e2131]\n- heading \"A Tour of Tokio\" [level=2, ref=e2132]\n- heading \"Authoring applications\" [level=4, ref=e2133]\n- heading \"Example\" [level=5, ref=e2134]\n- heading \"Authoring libraries\" [level=4, ref=e2135]\n- heading \"Example\" [level=5, ref=e2136]\n- heading \"Working With Tasks\" [level=3, ref=e2137]\n- link \"tasks\" [ref=e2138]\n- link \"tokio::task\" [ref=e2139]\n- link \"spawn\" [ref=e2140] hint=\"in:The function and JoinHandle type, for schedul\"\n- link \"JoinHandle\" [ref=e2141]\n- link \"running blocking operations\" [ref=e2142]\n- link \"tokio::task\" [ref=e2143]\n- link \"tokio::sync\" [ref=e2144]\n- link \"oneshot\" [ref=e2145] hint=\"in:channels (, mpsc, watch, and broadcast), for \"\n- link \"mpsc\" [ref=e2146]\n- link \"watch\" [ref=e2147]\n- link \"broadcast\" [ref=e2148]\n- link \"Mutex\" [ref=e2149]\n- link \"Barrier\" [ref=e2150]\n- link \"tokio::time\" [ref=e2151]\n- link \"timeouts\" [ref=e2152]\n- link \"sleeping\" [ref=e2153]\n- link \"repeating an operation at an interval\" [ref=e2154]\n- link \"#[tokio::main]\" [ref=e2155]\n- link \"tokio::runtime\" [ref=e2156]\n- link \"single-threaded scheduler\" [ref=e2157]\n- link \"multi-thread scheduler\" [ref=e2158]\n- link \"runtime module documentation\" [ref=e2159]\n- heading \"CPU-bound tasks and blocking code\" [level=3, ref=e2160]\n- link \"thread_keep_alive\" [ref=e2161]\n- link \"Builder\" [ref=e2162]\n- link \"spawn_blocking\" [ref=e2163]\n- link \"rayon\" [ref=e2164]\n- link \"oneshot\" [ref=e2165]\n- heading \"Asynchronous IO\" [level=3, ref=e2166]\n- link \"tokio::io\" [ref=e2167]\n- link \"AsyncRead\" [ref=e2168]\n- link \"AsyncWrite\" [ref=e2169]\n- link \"AsyncBufRead\" [ref=e2170]\n- link \"std::io\" [ref=e2171]\n- link \"tokio::net\" [ref=e2172]\n- link \"TCP\" [ref=e2173]\n- link \"UDP\" [ref=e2174]\n- link \"Unix Domain Sockets\" [ref=e2175]\n- link \"tokio::fs\" [ref=e2176]\n- link \"std::fs\" [ref=e2177]\n- link \"tokio::signal\" [ref=e2178]\n- link \"tokio::process\" [ref=e2179]\n- heading \"Examples\" [level=2, ref=e2180]\n- heading \"Feature flags\" [level=2, ref=e2181]\n- link \"feature flags\" [ref=e2182]\n- link \"parking_lot\" [ref=e2183] hint=\"in:: As a potential optimization, use the parkin\"\n- link \"parking_lot\" [ref=e2184] hint=\"in:: As a potential optimization, use the parkin\"\n- heading \"Unstable features\" [level=3, ref=e2185]\n- link \"does not yet directly support such opt-ins\" [ref=e2186]\n- heading \"Supported platforms\" [level=2, ref=e2187]\n- link \"in mio’s documentation\" [ref=e2188]\n- heading \"WASM support\" [level=3, ref=e2189]\n- heading \"WASI support\" [level=4, ref=e2190]\n- heading \"Emscripten support\" [level=4, ref=e2191]\n- heading \"Re-exports\" [level=2, ref=e2192]\n- link \"spawn\" [ref=e2193]\n- heading \"Modules\" [level=2, ref=e2194]\n- link \"doc\" [ref=e2195]\n- link \"fs\" [ref=e2196]\n- link \"io\" [ref=e2197]\n- link \"net\" [ref=e2198]\n- link \"process\" [ref=e2199]\n- link \"runtime\" [ref=e2200]\n- link \"signal\" [ref=e2201]\n- link \"stream\" [ref=e2202]\n- link \"tokio-stream\" [ref=e2203]\n- link \"sync\" [ref=e2204]\n- link \"task\" [ref=e2205]\n- link \"time\" [ref=e2206]\n- heading \"Macros\" [level=2, ref=e2207]\n- link \"join\" [ref=e2208]\n- link \"pin\" [ref=e2209]\n- link \"select\" [ref=e2210]\n- link \"task_local\" [ref=e2211]\n- link \"tokio::task::LocalKey\" [ref=e2212]\n- link \"try_join\" [ref=e2213]\n- heading \"Attribute Macros\" [level=2, ref=e2214]\n- link \"main\" [re