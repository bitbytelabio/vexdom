\"\n      - link \"smart pointer\" [ref=e489]\n      - link \"[94]\" [ref=e490]\n      - link \"option type\" [ref=e491]\n      - link \"[95]\" [ref=e492]\n      - link \"result type\" [ref=e493]\n      - link \"[96]\" [ref=e494]\n  - region \"Pointers\" [ref=e495]\n    - heading \"Pointers\" [level=3, ref=e496]\n    - link \"edit\" [ref=e497]\n    - link \"[97]\" [ref=e498]\n    - link \"[98]\" [ref=e499]\n    - link \"[99]\" [ref=e500]\n  - region \"Type conversion\" [ref=e501]\n    - heading \"Type conversion\" [level=3, ref=e502]\n    - link \"edit\" [ref=e503]\n    - link \"Type conversion § Rust\" [ref=e504]\n    - link \"edit\" [ref=e505]\n    - link \"[100]\" [ref=e506]\n    - button \"Play video\" [ref=e507]\n    - link [ref=e508]\n    - link \"Mozilla\" [ref=e509] hint=\"id:mwCW0\"\n    - link \"linux.conf.au\" [ref=e510]\n  - region \"Polymorphism\" [ref=e511]\n    - heading \"Polymorphism\" [level=3, ref=e512]\n    - link \"edit\" [ref=e513]\n    - link \"polymorphism\" [ref=e514]\n    - link \"traits\" [ref=e515]\n    - link \"generic functions\" [ref=e516]\n    - link \"trait objects\" [ref=e517] hint=\"id:mwCXQ\"\n    - link \"[101]\" [ref=e518]\n    - region \"Traits\" [ref=e519]\n      - heading \"Traits\" [level=4, ref=e520]\n      - link \"edit\" [ref=e521]\n      - link \"[102]\" [ref=e522] hint=\"id:mwCX0\"\n      - link \"[102]\" [ref=e523] hint=\"id:mwCe4\"\n    - region \"Generic functions\" [ref=e524]\n      - heading \"Generic functions\" [level=4, ref=e525]\n      - link \"edit\" [ref=e526]\n      - link \"[102]\" [ref=e527] hint=\"id:mwClA\"\n      - link \"[103]\" [ref=e528]\n      - link \"bounded parametric polymorphism\" [ref=e529]\n      - link \"[104]\" [ref=e530]\n    - region \"Trait objects\" [ref=e531]\n      - heading \"Trait objects\" [level=4, ref=e532]\n      - link \"edit\" [ref=e533]\n      - lin\n[truncated: 20000 of 110503 chars. Ask for less: snapshot with find, viewport, a selector or depth, or as markdown with outline, filter or a target.]\n<<</untrusted-page-data:c902cb6a63ba>>>"}],"isError":false}}
