> ul:nth-of-type(1) > li:nth-of-type(4) > a\",\"text\":\"Supported platforms\",\"href\":\"https://docs.rs/tokio/latest/tokio/#supported-platforms\",\"region\":\"section “Sections”\"},{\"selector\":\"#rustdoc-toc > ul:nth-of-type(1) > li:nth-of-type(4) > ul > li > a\",\"text\":\"WASM support\",\"href\":\"https://docs.rs/tokio/latest/tokio/#wasm-support\",\"region\":\"section “Sections”\"},{\"selector\":\"#rustdoc-toc > h3:nth-of-type(2) > a\",\"text\":\"Crate Items\",\"href\":\"https://docs.rs/tokio/latest/tokio/#reexports\",\"region\":\"section “Sections”\"},{\"selector\":\"#rustdoc-toc > ul:nth-of-type(2) > li:nth-of-type(1) > a\",\"text\":\"Re-exports\",\"href\":\"https://docs.rs/tokio/latest/tokio/#reexports\",\"region\":\"section “Sections”\"},{\"selector\":\"#rustdoc-toc > ul:nth-of-type(2) > li:nth-of-type(2) > a\",\"text\":\"Modules\",\"href\":\"https://docs.rs/tokio/latest/tokio/#modules\",\"region\":\"section “Sections”\"},{\"selector\":\"#rustdoc-toc > ul:nth-of-type(2) > li:nth-of-type(3) > a\",\"text\":\"Macros\",\"href\":\"https://docs.rs/tokio/latest/tokio/#macros\",\"region\":\"section “Sections”\"},{\"selector\":\"#rustdoc-toc > ul:nth-of-type(2) > li:nth-of-type(4) > a\",\"text\":\"Attribute Macros\",\"href\":\"https://docs.rs/tokio/latest/tokio/#attributes\",\"region\":\"section “Sections”\"},{\"selector\":\"#rustdoc-modnav > ul > li > a\",\"text\":\"tokio\",\"href\":\"https://docs.rs/tokio/latest/tokio/index.html\",\"region\":\"navigation “tokio1.54.1”\"},{\"selector\":\"#search-button > a\",\"text\":\"Search\",\"href\":\"https://docs.rs/tokio/latest/tokio/?search=\",\"region\":\"section “Crate tokio Copy item path”\"},{\"selector\":\"#main-content > div > rustdoc-toolbar > div:nth-of-type(2) > a\",\"text\":\"Settings\",\"href\":\"https://docs.rs/tokio/latest/settings.html\",\"region\":\"section “Crate tokio Copy item path”\"},{\"selector\":\"#main-content > div > rustdoc-toolbar > div:nth-of-type(3) > a\",\"text\":\"Help\",\"href\":\"https://docs.rs/tokio/latest/help.html\",\"region\":\"section “Crate tokio Copy item path”\"}],\"buttons\":[{\"selector\":\"#copy-path\",\"text\":\"Copy item path\",\"region\":\"section “Crate tokio Copy item path”\"},{\"selector\":\"#toggle-all-docs\",\"text\":\"Summary\",\"region\":\"section “Crate tokio Copy item path”\"}],\"fields\":[{\"tag\":\"input\",\"role\":\"textbox\",\"selector\":\"#nav-search\",\"text\":\"Find crate by search query\",\"state\":{\"filled\":false},\"kind\":\"text\",\"region\":\"form\"}],\"forms\":[{\"selector\":\"#nav-search-form\",\"action\":\"/releases/search\",\"method\":\"get\",\"region\":\"navigation “Main navigation”\"}],\"counts\":{\"links\":111,\"buttons\":2,\"fields\":1,\"forms\":1}}}\n<<</untrusted-page-data:TAG>>>"}]},"jsonrpc":"2.0","id":2}
