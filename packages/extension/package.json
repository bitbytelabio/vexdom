{
  "name": "vexdom",
  "version": "0.10.1",
  "description": "Vexdom: your real browser, driven by agents",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "setup": "bun scripts/setup.mjs",
    "postinstall": "wxt prepare",
    "dev": "bun run ext-core:build && wxt",
    "dev:firefox": "bun run ext-core:build && wxt -b firefox",
    "build": "bun run ext-core:build && wxt build",
    "build:firefox": "bun run ext-core:build && wxt build -b firefox",
    "zip": "bun run ext-core:build && wxt zip",
    "ext-core:build": "cd ../../crates/ext-core && boltffi pack wasm --release && bun ../../packages/extension/scripts/copy-ext-core.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox-mv2 --self-hosted",
    "sign:firefox": "web-ext sign --source-dir dist/firefox-mv2 --channel unlisted --artifacts-dir dist",
    "compile": "tsc --noEmit",
    "check": "bun run ext-core:build && bun run bridge:check && bun run compile && bun run coverage",
    "check:intent": "bun scripts/explain-intent.ts",
    "tools:emit": "bun scripts/emit-tools.ts",
    "test": "vitest run",
    "test:link": "vitest run --project link",
    "coverage": "vitest run --coverage",
    "bridge:build": "cargo build --release --manifest-path ../../Cargo.toml -p vexdom",
    "bridge:check": "cd ../.. && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "bridge:install": "cargo install --locked --path ../../app"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@boltffi/runtime": "0.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "esbuild": "^0.28.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.1",
    "web-ext": "^10.6.0",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
